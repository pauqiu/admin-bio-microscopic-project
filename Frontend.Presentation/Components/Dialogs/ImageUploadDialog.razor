@using UCR.EB.BioMicroscopeAdmin.Frontend.Presentation.Components
@inject IImageService ImageService

<MudDialog OnBackdropClick="OnBackdropClick">
    <TitleContent>Subir imágenes</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Elija varias fotos. La primera de esta selección ocupa el aumento libre más bajo.
            En el visor, el aumento 1 es la foto más lejana. Después puede reordenarlas arrastrando en la lámina.
        </MudText>
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesChanged" Accept="image/*" MaximumFileCount="100">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="@(_uploading || _attempts.Count > 0)">
                    Seleccionar fotos
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_attempts.Count == 0)
        {
            @foreach (var item in _preview.Accepted)
            {
                <MudText Typo="Typo.body2" Class="mt-2">@item.FileName · Aumento @item.Order</MudText>
            }
            @foreach (var item in _preview.Rejected)
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@item.FileName · @item.Reason</MudText>
            }
        }
        @foreach (var attempt in _attempts)
        {
            <MudText Typo="Typo.body2" Class="mt-2"
                     Color="@(attempt.Succeeded ? Color.Success : Color.Error)">
                @attempt.FileName · Aumento @attempt.Order · @(attempt.Succeeded ? "Subida" : attempt.Error)
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="_uploading">Cerrar</MudButton>
        @if (_attempts.Any(attempt => !attempt.Succeeded))
        {
            <MudButton OnClick="RetryFailed" Disabled="_uploading" Color="Color.Warning">Reintentar fallidas</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(_preview.Accepted.Count == 0 || _uploading || _attempts.Count > 0)">
            Subir
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public const int MaxImages = UploadPlan.MaxImages;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public int SlideId { get; set; }

    [Parameter] public IReadOnlyCollection<int> UsedOrders { get; set; } = [];

    private IReadOnlyList<IBrowserFile> _files = [];
    private UploadPlanResult _preview = new([], []);
    private readonly List<UploadAttempt> _attempts = [];
    private bool _uploading;
    private bool _anySucceeded;

    private void OnFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        if (_attempts.Count > 0) return;
        _files = files ?? [];
        var candidates = _files.Select((file, index) => new UploadCandidate(index, file.Name, file.Size)).ToList();
        _preview = UploadPlan.Plan(UsedOrders, candidates);
    }

    private Task Submit() => Send(_preview.Accepted);

    private Task RetryFailed()
    {
        var failed = _attempts.Where(attempt => !attempt.Succeeded).Select(attempt => attempt.Index).ToHashSet();
        var again = _preview.Accepted.Where(item => failed.Contains(item.Index)).ToList();
        return Send(again);
    }

    private async Task Send(IReadOnlyList<PlannedUpload> planned)
    {
        _uploading = true;
        try
        {
            var batch = await UploadBatch.RunAsync(planned, async item =>
            {
                var file = _files[item.Index];
                await using var stream = file.OpenReadStream(maxAllowedSize: UploadPlan.MaxFileBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                await ImageService.UploadAsync(SlideId, ms, file.Name, item.Order);
            });

            foreach (var attempt in batch)
            {
                var existing = _attempts.FindIndex(saved => saved.Index == attempt.Index);
                if (existing >= 0) _attempts[existing] = attempt;
                else _attempts.Add(attempt);
                if (attempt.Succeeded) _anySucceeded = true;
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private void OnBackdropClick()
    {
        if (_uploading) return;
        Close();
    }

    private void Close()
    {
        if (_anySucceeded) MudDialog.Close(DialogResult.Ok(true));
        else MudDialog.Cancel();
    }
}